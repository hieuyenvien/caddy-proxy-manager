# ====================================================
# Caddy WAF HA — Environment Configuration
# Copy file này thành .env và điền giá trị thực
#
# Generate secrets:
#   SESSION_SECRET:        openssl rand -base64 32
#   INSTANCE_SYNC_TOKEN:   openssl rand -hex 32
#   CLICKHOUSE_PASSWORD:   openssl rand -base64 24
# ====================================================

# ---- BẮT BUỘC ----

# Session secret — tối thiểu 32 ký tự ngẫu nhiên
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32

# Admin credentials
# Password: 12+ ký tự, có chữ hoa/thường, số, ký tự đặc biệt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_Your-Secure-P@ssw0rd!

# Base URL — PHẢI là VIP để Web UI tạo đúng URL trên cả 2 node
BASE_URL=http://10.2.159.20:3000

# ---- INSTANCE SYNC (HA) ----
# Cơ chế đồng bộ tích hợp sẵn, thay thế rsync qua SSH

# VM1 (.18) — master: push config sang VM2
# INSTANCE_MODE=master
# INSTANCE_SLAVES=[{"name":"vm2","url":"http://10.2.159.19:3000","token":"CHANGE_ME_openssl_rand_hex_32"}]
# INSTANCE_SYNC_INTERVAL=30
# INSTANCE_SYNC_ALLOW_HTTP=true

# VM2 (.19) — slave: nhận config từ VM1
# INSTANCE_MODE=slave
# INSTANCE_SYNC_TOKEN=CHANGE_ME_same_token_as_in_INSTANCE_SLAVES_token_field

# ---- DOCKER (rootless) ----
# UID/GID của user dockerwaf — lấy bằng: id dockerwaf
PUID=1001
PGID=1001

# ---- ANALYTICS (ClickHouse) ----
# Bỏ COMPOSE_PROFILES nếu không dùng analytics
COMPOSE_PROFILES=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME_openssl_rand_base64_24
CLICKHOUSE_USER=cpm
CLICKHOUSE_DB=analytics

# ---- LOG ----
CADDY_LOG_DIR=/home/dockerwaf/caddy-logs

# ---- TÙY CHỌN ----
# PRIMARY_DOMAIN=waf.example.com
# CADDY_API_URL=http://caddy:2019
# L4_PORT_MANAGER_POLL_INTERVAL=2

# OAuth2/OIDC (để trống nếu không dùng)
# OAUTH_ENABLED=false
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ISSUER=

# GeoIP (để trống nếu không có license)
# GEOIPUPDATE_ACCOUNT_ID=
# GEOIPUPDATE_LICENSE_KEY=
